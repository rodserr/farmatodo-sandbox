# =====================================================================
# VARIABLES DE ENTORNO - FARMATODO SANDBOX
# Copia este archivo como '.env' (no se subirá al repositorio de GitHub)
# =====================================================================

# Clave de API de Google Maps Platform (New Places API / Geocoding)
# Obtén tu clave en Google Cloud Console
GOOGLE_MAPS_API_KEY=tu_api_key_aqui

# Ruta personalizada para la carpeta de datos (opcional)
# Por defecto se autodetecta ./data o /content/drive/MyDrive/farmatodo-sandbox
# DATA_DIR=./data
